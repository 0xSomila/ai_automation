{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catalyst7.co.za/schemas/client-config.json",
  "title": "C7 Automation OS Client Config",
  "description": "Reference JSON Schema for a client config. The authoritative validator is core/config/loader.ts (zod). Keep this in sync.",
  "type": "object",
  "required": ["slug", "vertical", "name", "channelPhoneId", "booking"],
  "additionalProperties": true,
  "properties": {
    "slug": { "type": "string", "minLength": 1 },
    "vertical": { "enum": ["practitioner", "restaurant", "salon", "service"] },
    "name": { "type": "string", "minLength": 1 },
    "location": { "type": "string" },
    "timezone": { "type": "string", "default": "Africa/Johannesburg" },
    "channelPhoneId": { "type": "string", "minLength": 1 },
    "hours": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["open", "close"],
          "properties": {
            "open": { "type": "string" },
            "close": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "durationMin": { "type": "integer", "minimum": 1 },
          "priceZar": { "type": "number", "minimum": 0 },
          "staff": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "menuLink": { "type": "string", "format": "uri" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["practitioner", "table", "staff", "provider"] },
          "capacity": { "type": "integer", "minimum": 1, "default": 1 }
        }
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "cancellation": { "type": "string" },
        "medicalAid": { "type": "string" },
        "referral": { "type": "string" },
        "partySizeLimit": { "type": "integer", "minimum": 1 }
      }
    },
    "booking": {
      "type": "object",
      "required": ["backend"],
      "properties": {
        "backend": { "type": "string" },
        "config": { "type": "object" }
      }
    },
    "extras": { "type": "object" }
  }
}
