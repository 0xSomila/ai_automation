# Required for the terminal chat harness (npm run chat)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Cost control
MAX_TOOL_ROUNDS=4

# Required only for production (WhatsApp + Supabase + Calendar)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=          # verifies X-Hub-Signature-256 on inbound webhooks
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
PORT=3000
DEFAULT_CLIENT_SLUG=meridian

# Shared secret between n8n and the Core /cron/* endpoints
N8N_WEBHOOK_SECRET=
