# Required for the terminal chat harness (npm run chat)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Cost control
MAX_TOOL_ROUNDS=4

# Required only for production (WhatsApp + Supabase + Calendar)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=          # verifies X-Hub-Signature-256 on inbound webhooks
GOOGLE_CALENDAR_ID=
# Set to the dedicated Meridian pilot calendar ID to enable its retention cleanup.
MERIDIAN_RETENTION_CALENDAR_ID=
# Set the path to the downloaded service account key file, or supply inline JSON.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
PORT=3000
DEFAULT_CLIENT_SLUG=meridian

# Optional read-only dashboard connection. Use a separate random token, at least 32 characters.
# Leave blank to disable remote bearer-token access.
DASHBOARD_ACCESS_TOKEN=
DASHBOARD_CLIENT_SLUG=meridian
# Optional local-browser connection, without pasting a dashboard token.
# Same-origin loopback only; refused through tunnels and forwarded requests.
DASHBOARD_LOCAL_ACCESS=false

# Shared secret between n8n and the Core /cron/* endpoints
N8N_WEBHOOK_SECRET=
